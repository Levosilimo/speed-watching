{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/refs/heads/main/crates/oxc_linter/source/oxlint.schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "env": {
    "browser": true,
    "node": true,
    "bun": true
  },
  "globals": {
    "Bun": "readonly"
  },
  "settings": {
    "typescript-ai-policy": true
  },
  "rules": {
    "no-var": "error",
    "prefer-const": "error",
    "no-undef": "error",
    "@typescript-eslint/no-unused-vars": "error",
    "@typescript-eslint/no-non-null-assertion": "error",
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-unnecessary-condition": "error",
    "no-throw-literal": "error",
    "no-extra-boolean-cast": "error",
    "no-constant-binary-expression": "error",
    "no-implicit-coercion": "error",
    "max-params": [
      "warn",
      {
        "max": 4
      }
    ],
    "no-explicit-any": "error",
    "no-empty": "error",
    "ban-ts-comment": "error",
    "no-unused-vars": "warn"
  }
}
