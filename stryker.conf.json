{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": true
  },
  "mutate": [
    "lib/wpm.ts",
    "lib/tokenizer.ts",
    "lib/captions.ts",
    "lib/languages.ts",
    "lib/recommend.ts",
    "lib/caption-fetch.ts",
    "lib/caption-trigger.ts",
    "lib/transcript.ts",
    "lib/matcher.ts",
    "lib/rate-controller.ts",
    "lib/demand.ts",
    "lib/time-saved.ts",
    "lib/chapters.ts",
    "lib/chapter-scheduler.ts",
    "lib/skip-silence.ts",
    "lib/error-journal.ts",
    "lib/nudge.ts",
    "lib/channel-memory.ts",
    "lib/caption-capture.ts",
    "lib/music.ts",
    "lib/live.ts",
    "lib/auto-apply.ts",
    "lib/override-log.ts",
    "lib/settings.ts",
    "lib/heuristics.ts",
    "lib/youtube.ts",
    "lib/messaging.ts",
    "lib/bridge-protocol.ts",
    "lib/wpm-provider.ts",
    "lib/audio-capture.ts",
    "lib/audio-probe.ts",
    "lib/audio-recorder.ts",
    "lib/captions-harvest.ts",
    "lib/capture-orchestrator.ts",
    "lib/i18n.ts",
    "lib/i18n-ru.ts",
    "lib/model-store.ts",
    "lib/resampler.ts",
    "lib/measure-guard.ts",
    "lib/rate-controller-types.ts",
    "lib/wpm-protocol.ts"
  ],
  "thresholds": {
    "high": 80,
    "low": 65,
    "break": 65
  },
  "incremental": true,
  "ignoreStatic": true,
  "coverageAnalysis": "perTest",
  "reporters": [
    "clear-text",
    "html",
    "progress",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "ignorePatterns": [
    "dist",
    ".output",
    "e2e"
  ]
}