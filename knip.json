{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "entrypoints/background.ts",
    "entrypoints/content.ts",
    "entrypoints/generic.content.ts",
    "entrypoints/bridge.content.ts",
    "entrypoints/offscreen/main.ts",
    "entrypoints/options/*.ts",
    "ui/pill.ts",
    "userscript/src/main.ts",
    "wxt.config.ts",
    "scripts/**/*.ts",
    "e2e/**/*.ts"
  ],
  "project": [
    "**/*.ts"
  ],
  // New modules awaiting entrypoint wiring (caption-capture lane part 2);
  // drop these entries when content.ts imports them.
  "ignore": ["lib/caption-capture.ts", "lib/caption-trigger.ts"],
  "ignoreDependencies": [
    "block-no-verify",
    "@ast-grep/cli",
    "@cws-check/cli",
    "vitest-chrome",
    "@huggingface/transformers",
    "sharp"
  ],
  "ignoreBinaries": ["ffmpeg", "yt-dlp"],
  "ignoreExportsUsedInFile": true
}
