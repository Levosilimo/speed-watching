 "events": [
  {
   "tStartMs": 12645,
   "dDurationMs": 1370,
   "segs": [
    {
     "utf8": "So in college,"
    }
   ]
  },
  {
   "tStartMs": 15349,
   "dDurationMs": 1564,
   "segs": [
    {
     "utf8": "I was a government major,"
    }
   ]
  },
  {
   "tStartMs": 16937,
   "dDurationMs": 2462,
   "segs": [
    {
     "utf8": "which means I had to write\na lot of papers."
    }
   ]
  },
  {
   "tStartMs": 19423,
   "dDurationMs": 2048,
   "segs": [
    {
     "utf8": "Now, when a normal student writes a paper,"
    }
   ]
  },
  {
   "tStartMs": 21495,
   "dDurationMs": 2373,
   "segs": [
    {
     "utf8": "they might spread the work out\na little like this."
    }
   ]
  },
  {
   "tStartMs": 23892,
   "dDurationMs": 1151,
   "segs": [
    {
     "utf8": "So, you know --"
    }
   ]
  },
  {
   "tStartMs": 25067,
   "dDurationMs": 1657,
   "segs": [
    {
     "utf8": "(Laughter)"
    }
   ]
  },
  {
   "tStartMs": 26748,
   "dDurationMs": 1827,
   "segs": [
    {
     "utf8": "you get started maybe a little slowly,"
    }
   ]
  },
  {
   "tStartMs": 28599,
   "dDurationMs": 1968,
   "segs": [
    {
     "utf8": "but you get enough done in the first week"
    }
   ]
  },
  {
   "tStartMs": 30591,
   "dDurationMs": 1831,
   "segs": [
    {
     "utf8": "that, with some heavier days later on,"
    }
   ]
  },
  {
   "tStartMs": 32446,
   "dDurationMs": 2157,
   "segs": [
    {
     "utf8": "everything gets done, things stay civil."
    }
   ]
  },
  {
   "tStartMs": 34627,
   "dDurationMs": 1202,
   "segs": [
    {
     "utf8": "(Laughter)"
    }
   ]
  },
  {
   "tStartMs": 35853,
   "dDurationMs": 2271,
   "segs": [
    {
     "utf8": "And I would want to do that like that."
    }
   ]
  },
  {
   "tStartMs": 38148,
   "dDurationMs": 1194,
   "segs": [
    {
     "utf8": "That would be the plan."
    }
   ]
  },
  {
   "tStartMs": 39366,
   "dDurationMs": 2490,
   "segs": [
    {
     "utf8": "I would have it all ready to go,"
    }
   ]
  },
  {
   "tStartMs": 41880,
   "dDurationMs": 2494,
   "segs": [
    {
     "utf8": "but then, actually, the paper\nwould come along,"
    }
   ]
  },
  {
   "tStartMs": 44398,
   "dDurationMs": 1941,
   "segs": [
    {
     "utf8": "and then I would kind of do this."
    }
   ]
  },
  {
   "tStartMs": 46363,
   "dDurationMs": 2370,
   "segs": [
    {
     "utf8": "(Laughter)"
    }
   ]
  },
  {
   "tStartMs": 48757,
   "dDurationMs": 2143,
   "segs": [
    {
     "utf8": "And that would happen every single paper."
    }
   ]
  },
  {
   "tStartMs": 51638,
   "dDurationMs": 3882,
   "segs": [
    {
     "utf8": "But then came my 90-page senior thesis,"
    }
   ]
  }
 ],
 "windows": []
}