 "events": [
  {
   "tStartMs": 0,
   "dDurationMs": 7000,
   "segs": [
    {
     "utf8": "Translator: Joseph Geni\nReviewer: Morton Bast"
    }
   ]
  },
  {
   "tStartMs": 15967,
   "dDurationMs": 5398,
   "segs": [
    {
     "utf8": "So I want to start by offering you\na free no-tech life hack,"
    }
   ]
  },
  {
   "tStartMs": 21389,
   "dDurationMs": 2597,
   "segs": [
    {
     "utf8": "and all it requires of you is this:"
    }
   ]
  },
  {
   "tStartMs": 24010,
   "dDurationMs": 4163,
   "segs": [
    {
     "utf8": "that you change your posture\nfor two minutes."
    }
   ]
  },
  {
   "tStartMs": 28197,
   "dDurationMs": 3400,
   "segs": [
    {
     "utf8": "But before I give it away,\nI want to ask you to right now"
    }
   ]
  },
  {
   "tStartMs": 31621,
   "dDurationMs": 3569,
   "segs": [
    {
     "utf8": "do a little audit of your body\nand what you're doing with your body."
    }
   ]
  },
  {
   "tStartMs": 35214,
   "dDurationMs": 2691,
   "segs": [
    {
     "utf8": "So how many of you are\nsort of making yourselves smaller?"
    }
   ]
  },
  {
   "tStartMs": 37929,
   "dDurationMs": 3321,
   "segs": [
    {
     "utf8": "Maybe you're hunching, crossing your legs,\nmaybe wrapping your ankles."
    }
   ]
  },
  {
   "tStartMs": 41274,
   "dDurationMs": 3715,
   "segs": [
    {
     "utf8": "Sometimes we hold onto our arms like this."
    }
   ]
  },
  {
   "tStartMs": 45013,
   "dDurationMs": 3647,
   "segs": [
    {
     "utf8": "Sometimes we spread out. (Laughter)"
    }
   ]
  },
  {
   "tStartMs": 48684,
   "dDurationMs": 2248,
   "segs": [
    {
     "utf8": "I see you."
    }
   ]
  },
  {
   "tStartMs": 50956,
   "dDurationMs": 2991,
   "segs": [
    {
     "utf8": "So I want you to pay attention\nto what you're doing right now."
    }
   ]
  },
  {
   "tStartMs": 53971,
   "dDurationMs": 2334,
   "segs": [
    {
     "utf8": "We're going to come back\nto that in a few minutes,"
    }
   ]
  },
  {
   "tStartMs": 56329,
   "dDurationMs": 2924,
   "segs": [
    {
     "utf8": "and I'm hoping that if you learn\nto tweak this a little bit,"
    }
   ]
  },
  {
   "tStartMs": 59277,
   "dDurationMs": 3412,
   "segs": [
    {
     "utf8": "it could significantly change\nthe way your life unfolds."
    }
   ]
  },
  {
   "tStartMs": 62713,
   "dDurationMs": 4500,
   "segs": [
    {
     "utf8": "So, we're really fascinated\nwith body language,"
    }
   ]
  },
  {
   "tStartMs": 67237,
   "dDurationMs": 3899,
   "segs": [
    {
     "utf8": "and we're particularly interested\nin other people's body language."
    }
   ]
  },
  {
   "tStartMs": 71160,
   "dDurationMs": 4197,
   "segs": [
    {
     "utf8": "You know, we're interested in,\nlike, you know — (Laughter) —"
    }
   ]
  },
  {
   "tStartMs": 75381,
   "dDurationMs": 4374,
   "segs": [
    {
     "utf8": "an awkward interaction, or a smile,"
    }
   ]
  },
  {
   "tStartMs": 79779,
   "dDurationMs": 4208,
   "segs": [
    {
     "utf8": "or a contemptuous glance,\nor maybe a very awkward wink,"
    }
   ]
  }
 ],
 "windows": []
}